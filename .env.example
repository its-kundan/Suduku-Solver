# =============================================================================
# SUDOKU PREMIUM - ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env and fill in your actual values
# Never commit .env files to version control!

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL="postgresql://username:password@localhost:5432/sudoku_premium"

# =============================================================================
# NEXT.JS CONFIGURATION
# =============================================================================
# Base URL for your application
NEXTAUTH_URL="http://localhost:3000"

# Secret key for NextAuth.js (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="your-nextauth-secret-key-here"

# =============================================================================
# AUTHENTICATION (NEXTAUTH)
# =============================================================================
# Google OAuth (Optional - for Google sign-in)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Email Provider (Optional - for magic link authentication)
# SMTP configuration for sending emails
EMAIL_SERVER="smtp://username:password@smtp.gmail.com:587"
EMAIL_FROM="noreply@sudoku.app"

# =============================================================================
# RATE LIMITING (UPSTASH REDIS)
# =============================================================================
# Upstash Redis for rate limiting and caching
# Get these from: https://upstash.com/
UPSTASH_REDIS_REST_URL="https://your-redis-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-redis-token"

# =============================================================================
# REAL-TIME FEATURES (OPTIONAL)
# =============================================================================
# Choose your real-time provider: "pusher" or "ably"
REALTIME_PROVIDER="pusher"

# Pusher Configuration (if using Pusher)
PUSHER_APP_ID="your-pusher-app-id"
PUSHER_KEY="your-pusher-key"
PUSHER_SECRET="your-pusher-secret"
PUSHER_CLUSTER="your-pusher-cluster"

# Ably Configuration (if using Ably)
ABLY_API_KEY="your-ably-api-key"

# =============================================================================
# TIMEZONE CONFIGURATION
# =============================================================================
# IST timezone for daily puzzle generation
# Default: Asia/Kolkata (Indian Standard Time)
IST_TZ="Asia/Kolkata"

# =============================================================================
# DEVELOPMENT & TESTING
# =============================================================================
# Node environment
NODE_ENV="development"

# Enable debug logging
DEBUG="*"

# =============================================================================
# SECURITY
# =============================================================================
# CORS origins (comma-separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# Rate limiting configuration
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_MAX_REQUESTS="100"
RATE_LIMIT_WINDOW_MS="60000"

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Enable/disable features
ENABLE_ACHIEVEMENTS="true"
ENABLE_LEADERBOARDS="true"
ENABLE_STREAKS="true"
ENABLE_XP_SYSTEM="true"
ENABLE_HINTS="true"
ENABLE_ANALYTICS="false"

# =============================================================================
# MONITORING & ANALYTICS (OPTIONAL)
# =============================================================================
# Sentry for error tracking
SENTRY_DSN="your-sentry-dsn"

# Google Analytics
NEXT_PUBLIC_GA_ID="your-ga-id"

# =============================================================================
# DEPLOYMENT
# =============================================================================
# Vercel (if deploying to Vercel)
VERCEL_URL="your-vercel-url"

# =============================================================================
# EXAMPLE VALUES FOR LOCAL DEVELOPMENT
# =============================================================================
# DATABASE_URL="postgresql://postgres:password@localhost:5432/sudoku_dev"
# NEXTAUTH_URL="http://localhost:3000"
# NEXTAUTH_SECRET="dev-secret-key-change-in-production"
# UPSTASH_REDIS_REST_URL="https://your-redis-url.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your-redis-token"
# IST_TZ="Asia/Kolkata"

# =============================================================================
# NOTES
# =============================================================================
# 1. Replace all placeholder values with your actual credentials
# 2. Keep .env files out of version control
# 3. Use different values for development, staging, and production
# 4. Regularly rotate sensitive keys and secrets
# 5. Use strong, unique passwords for all services
