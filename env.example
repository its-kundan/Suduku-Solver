# Database
DATABASE_URL="postgresql://username:password@localhost:5432/sudoku_premium"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"

# OAuth Providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email (optional for magic link auth)
EMAIL_SERVER="smtp://username:password@smtp.gmail.com:587"
EMAIL_FROM="noreply@sudoku.app"

# Rate Limiting (optional)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Real-time Updates
REALTIME_PROVIDER="pusher" # pusher|ably|none

# Pusher (if using Pusher)
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER=""

# Ably (if using Ably)
ABLY_API_KEY=""

# Timezone
IST_TZ="Asia/Kolkata"

# App Configuration
NODE_ENV="development"
