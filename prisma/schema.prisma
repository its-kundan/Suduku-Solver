// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String?  @unique
  image     String?
  provider  String?
  createdAt DateTime @default(now())
  plays     Play[]
  xp        UserXP?
  streak    Streak?
  achievements UserAchievement[]
  admin     Admin?

  @@index([email])
  @@index([createdAt])
}

model Admin {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Puzzle {
  id         String   @id @default(cuid())
  dateKey    String?  // YYYY-MM-DD for daily, null for practice
  difficulty String   // easy, medium, hard, expert
  seed       String
  puzzle     Json     // 9x9 grid with numbers
  solution   Json     // 9x9 grid with solution
  createdAt  DateTime @default(now())
  plays      Play[]

  @@unique([dateKey, difficulty])
  @@index([dateKey])
  @@index([difficulty])
  @@index([createdAt])
}

model Play {
  id         String   @id @default(cuid())
  userId     String
  puzzleId   String
  startedAt  DateTime @default(now())
  finishedAt DateTime?
  seconds    Int      @default(0)
  mistakes   Int      @default(0)
  hintsUsed  Int      @default(0)
  status     String   @default("in_progress") // completed, abandoned
  score      Int      @default(0)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  puzzle     Puzzle   @relation(fields: [puzzleId], references: [id], onDelete: Cascade)

  @@unique([userId, puzzleId])
  @@index([userId])
  @@index([puzzleId])
  @@index([status])
  @@index([finishedAt])
  @@index([score])
}

model Streak {
  id            String   @id @default(cuid())
  userId        String   @unique
  currentCount  Int      @default(0)
  longestCount  Int      @default(0)
  lastPlayedIST DateTime?
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([currentCount])
  @@index([longestCount])
}

model LeaderboardDaily {
  id       String @id @default(cuid())
  dateKey  String
  userId   String
  seconds  Int
  mistakes Int
  score    Int
  createdAt DateTime @default(now())

  @@unique([userId, dateKey])
  @@index([dateKey])
  @@index([userId])
  @@index([score])
  @@index([seconds])
}

model Achievement {
  id          String @id @default(cuid())
  code        String @unique
  title       String
  description String
  icon        String
  criteria    Json   // Achievement criteria
  users       UserAchievement[]
  createdAt   DateTime @default(now())
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  achievementId String
  earnedAt      DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
  @@index([earnedAt])
}

model Level {
  code     String @id
  minXP    Int
  title    String
  description String?
  users    UserXP[]
  createdAt DateTime @default(now())
}

model UserXP {
  id        String @id @default(cuid())
  userId    String @unique
  xp        Int    @default(0)
  levelCode String?
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  level     Level? @relation(fields: [levelCode], references: [code])

  @@index([xp])
  @@index([levelCode])
}